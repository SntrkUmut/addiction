# Supabase Configuration
# Copy this to .env and fill with your project values
# Never commit real credentials!

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Channel for remote manifest (beta or prod)
# Defaults to beta if not set
# EXPO_PUBLIC_MANIFEST_CHANNEL=beta
