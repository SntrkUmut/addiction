# Supabase Configuration (optional)
# If not set, the app works fully offline with bundled content only.
# Remote manifest fetch and cloud sync will be silently disabled.

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Your Supabase publishable (anon) key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Note: Service-role keys and write operations are NOT used by this app.
# Content publishing and snapshot writes are done manually by the owner.
