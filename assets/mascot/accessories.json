 "_notes": {
  "canvas": "Her katman tilki pozlarıyla aynı kare tuvalde (342/683/1024), fox_idle ile piksel hizalı. region≠(0,0,1) ise katman tilki tuvaline göre x,y ofsetli ve size kat büyük bir karedir (bkz. README).",
  "transform": "RN sırası: translateX(tx·W), translateY(ty·W), rotate(rotate deg), scale(scale); merkez=tuval merkezi, pozitif açı saat yönü. p' = c + (tx,ty)·W + R·scale·(p−c).",
  "layer": "front = tilkinin önünde, back = tilkinin arkasında"
 },
